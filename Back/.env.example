# Copy with: python scripts/init_env.py. This file never contains real server credentials.
ENVIRONMENT=development
JWT_SECRET=GENERATE_JWT_SECRET
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY
DATABASE_URL=postgresql+psycopg://kb_admin:CHANGE_ME@127.0.0.1:15432/knowledge_base
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# Existing independent MinIO; tunnel local 9000 to remote 9000.
# The Milvus-associated MinIO (remote 9002) also works if you tunnel 9000 to 9002.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=kb-documents
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=kb_chunks_bge_m3_v1
EMBEDDING_MODEL_PATH=D:\ai_models\modelscope_cache\models\models\BAAI--bge-m3
# cuda requires the CUDA torch wheel; pyproject.toml already points at cu126.
EMBEDDING_DEVICE=cpu
EMBEDDING_DTYPE=float32
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_TOKENS=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Automatically run document import/index workflows with the API server.
WORKER_AUTO_START=true
WORKER_POLL_SECONDS=1
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
KB_LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=high
# Enable to analyze MinerU-extracted figures before chunking. Uses the same backend API Key.
LLM_VISION_ENABLED=false
LLM_VISION_MODEL=deepseek-flash
LLM_VISION_MAX_IMAGES=100
LLM_ANSWER_MAX_IMAGES=3
LLM_ANSWER_IMAGE_MAX_BYTES=5242880
# MinerU v4 cloud parsing. Token: https://mineru.net/apiManage/token
MINERU_ENABLED=false
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=
MINERU_MODEL_VERSION=pipeline
MINERU_ENABLE_OCR=true
MINERU_LANGUAGE=ch
MINERU_POLL_SECONDS=5
MINERU_TIMEOUT_SECONDS=900
